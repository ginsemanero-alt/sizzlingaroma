# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Only needed for the Owner's "Users" page (creating staff accounts / resetting passwords).
SUPABASE_SECRET_KEY=

# Domain used for username logins (username "maria" signs in as maria@<domain>).
NEXT_PUBLIC_USERNAME_DOMAIN=staff.sizzlingaroma.local

# Only used by `npm run db:migrate` / `npm run db:seed` from your computer (psql required).
# Session pooler string from Supabase → Connect. Never commit the real password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
